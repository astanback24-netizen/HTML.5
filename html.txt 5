  let quizCurrentQuestion = 0;
  let quizUserAnswers = new Array(quizQuestions.length).fill(null);
  let quizStudentName = '';

  function startQuizSection() {
    const nameInput = document.getElementById('quiz-student-name');
    quizStudentName = nameInput.value.trim();
   
    if (!quizStudentName) {
      nameInput.style.borderColor = '#ff3333';
      return;
    }
   
    document.getElementById('quiz-start-screen').style.display = 'none';
    document.getElementById('quiz-quiz-screen').style.display = 'block';
    displayQuizQuestion();
  }

  function displayQuizQuestion() {
    const question = quizQuestions[quizCurrentQuestion];
    document.getElementById('quiz-question-number').textContent = `Question ${quizCurrentQuestion + 1} of ${quizQuestions.length}`;
    document.getElementById('quiz-question-text').textContent = question.question;
   
    const optionsContainer = document.getElementById('quiz-options');
    optionsContainer.innerHTML = '';
   
    question.options.forEach((option, index) => {
      const optionDiv = document.createElement('div');
      optionDiv.className = 'quiz-option';
      if (quizUserAnswers[quizCurrentQuestion] === index) {
        optionDiv.classList.add('selected');
      }
     
      optionDiv.innerHTML = `
        <label>
          <input type="radio" name="quiz-answer" value="${index}" ${quizUserAnswers[quizCurrentQuestion] === index ? 'checked' : ''}>
          <span>${option}</span>
        </label>
      `;
     
      optionDiv.onclick = () => selectQuizAnswer(index);
      optionsContainer.appendChild(optionDiv);
    });
   
    updateQuizProgress();
    updateQuizNavigationButtons();
  }

  function selectQuizAnswer(index) {
    quizUserAnswers[quizCurrentQuestion] = index;
    displayQuizQuestion();
  }

  function updateQuizProgress() {
    const progress = ((quizCurrentQuestion + 1) / quizQuestions.length) * 100;
    document.getElementById('quiz-progress-fill').style.width = progress + '%';
  }

  function updateQuizNavigationButtons() {
    const prevBtn = document.getElementById('quiz-prev-btn');
    const nextBtn = document.getElementById('quiz-next-btn');
   
    prevBtn.disabled = quizCurrentQuestion === 0;
   
    if (quizCurrentQuestion === quizQuestions.length - 1) {
      nextBtn.textContent = 'Submit Quiz';
    } else {
      nextBtn.textContent = 'Next';
    }
  }

  function nextQuizQuestion() {
    if (quizUserAnswers[quizCurrentQuestion] === null) {
      return;
    }
   
    if (quizCurrentQuestion === quizQuestions.length - 1) {
      submitQuizSection();
    } else {
      quizCurrentQuestion++;
      displayQuizQuestion();
    }
  }

  function previousQuizQuestion() {
    if (quizCurrentQuestion > 0) {
      quizCurrentQuestion--;
      displayQuizQuestion();
    }
  }

  function submitQuizSection() {
    const allAnswered = quizUserAnswers.every(answer => answer !== null);
    if (!allAnswered) {
      return;
    }
   
    let correctCount = 0;
    quizQuestions.forEach((question, index) => {
      if (quizUserAnswers[index] === question.correct) {
        correctCount++;
      }
    });
   
    const percentage = Math.round((correctCount / quizQuestions.length) * 100);
    const passed = percentage >= 80;
   
    document.getElementById('quiz-quiz-screen').style.display = 'none';
    document.getElementById('quiz-results-screen').style.display = 'block';
   
    document.getElementById('quiz-score-display').textContent = `${correctCount}/${quizQuestions.length} (${percentage}%)`;
   
    const messageDiv = document.getElementById('quiz-pass-fail-message');
    if (passed) {
      messageDiv.innerHTML = '<div class="text-2xl font-semibold text-green-500 my-4">✓ Congratulations! You Passed!</div>';
      displayQuizCertificate();
    } else {
      messageDiv.innerHTML = '<div class="text-2xl font-semibold my-4" style="color: #ef4444;">✗ You did not pass. Please review the material and try again.</div>';
      document.getElementById('quiz-certificate-container').innerHTML = '';
    }
  }

  function displayQuizCertificate() {
    const today = new Date().toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
   
