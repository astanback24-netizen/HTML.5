  function restartQuizSection() {
    quizCurrentQuestion = 0;
    quizUserAnswers = new Array(quizQuestions.length).fill(null);
    quizStudentName = '';
    document.getElementById('quiz-student-name').value = '';
    document.getElementById('quiz-results-screen').style.display = 'none';
    document.getElementById('quiz-start-screen').style.display = 'block';
